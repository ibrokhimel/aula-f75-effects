# AULA F75 (and F87/F99 family, SinoWealth 258A) — allow Chromium/WebHID
# to open the keyboard's /dev/hidraw node without root.
# MODE="0666" sidesteps requiring the user to be in the "input" group; if you
# prefer tighter perms use MODE="0660", GROUP="input" and add your user to that
# group (sudo usermod -aG input $USER, then log out/in).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", MODE="0666"